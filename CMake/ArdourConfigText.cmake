# libs/ardour/config_text.cc: the build summary libardour reports
# (ARDOUR::ardour_config_info, shown in the About dialog and the log). The root
# wscript's configure() writes it with write_config_text(); the same titles in
# the same order are written here. Values are what this CMake configure
# decided, printed the way waf prints them (Python True/False).

function(_ardour_py_bool out)
    if (${ARGN})
        set(${out} "True" PARENT_SCOPE)
    else ()
        set(${out} "False" PARENT_SCOPE)
    endif ()
endfunction()

macro(_ardour_cfg title value)
    string(REPLACE "\"" "\\\"" _v "${value}")
    string(APPEND _text "${title}: ${_v}\\n\\\n")
endmacro()

macro(_ardour_cfg_bool title)
    _ardour_py_bool(_b ${ARGN})
    _ardour_cfg("${title}" "${_b}")
endmacro()

macro(_ardour_cfg_defined title name)
    ardour_is_defined(${name} _d)
    _ardour_cfg_bool("${title}" _d)
endmacro()

macro(_ardour_cfg_gap)
    string(APPEND _text "\\n\\\n")
endmacro()

function(ardour_write_config_text out)
    set(_text "")

    set(_debug OFF)
    if (CMAKE_BUILD_TYPE STREQUAL "Debug")
        set(_debug ON)
    endif ()
    set(_backends "${ARDOUR_BACKENDS}")

    _ardour_cfg("Build documentation" "False")
    _ardour_cfg_bool("Debuggable build" _debug)
    _ardour_cfg("Export all symbols (backtrace)" "False")
    _ardour_cfg("Install prefix" "${CMAKE_INSTALL_PREFIX}")
    _ardour_cfg("Strict compiler flags" "[]")
    _ardour_cfg_defined("Internal Shared Libraries" INTERNAL_SHARED_LIBS)
    _ardour_cfg_defined("Use External Libraries" USE_EXTERNAL_LIBS)
    _ardour_cfg_defined("Library exports hidden" EXPORT_VISIBILITY_HIDDEN)
    _ardour_cfg_defined("Free/Demo copy" FREEBIE)
    _ardour_cfg_gap()
    _ardour_cfg_defined("ALSA DBus Reservation" HAVE_DBUS)
    _ardour_cfg("Architecture flags" "None")
    _ardour_cfg_defined("ARM NEON support" ARM_NEON_SUPPORT)
    _ardour_cfg_defined("Aubio" HAVE_AUBIO)
    _ardour_cfg_defined("AudioUnits" AUDIOUNIT_SUPPORT)
    _ardour_cfg("Build target" "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
    _ardour_cfg_defined("Canvas Test UI" CANVASTESTUI)
    _ardour_cfg_defined("Beatbox test app" BEATBOX)
    _ardour_cfg_defined("CoreAudio" HAVE_COREAUDIO)
    _ardour_cfg_defined("Debug RT allocations" DEBUG_RT_ALLOC)
    _ardour_cfg_bool("Debug Symbols" _debug)
    _ardour_cfg_defined("Denormal exceptions" DEBUG_DENORMAL_EXCEPTION)
    _ardour_cfg_defined("Dr. Mingw" HAVE_DRMINGW)
    _ardour_cfg_defined("FLAC" HAVE_FLAC)
    _ardour_cfg_bool("FPU optimization" ARDOUR_FPU_OPTIMIZATION)
    _ardour_cfg_defined("FPU AVX512F support" FPU_AVX512F_SUPPORT)
    _ardour_cfg_defined("FPU AVX/FMA support" FPU_AVX_FMA_SUPPORT)
    _ardour_cfg_defined("Futex Semaphore" USE_FUTEX_SEMAPHORE)
    _ardour_cfg("Freedesktop files" "False")
    _ardour_cfg_bool("G_ENABLE_DEBUG" _debug OR ARDOUR_GTK_DEBUG)
    _ardour_cfg_defined("I/O Priority Set" HAVE_IOPRIO)
    _ardour_cfg("Libjack linking" "[]")
    _ardour_cfg_defined("Libjack metadata" HAVE_JACK_METADATA)
    _ardour_cfg_defined("Lua Binding Doc" LUABINDINGDOC)
    _ardour_cfg_defined("Lua Commandline Tool" HAVE_READLINE)
    _ardour_cfg_defined("LV2 UI embedding" HAVE_SUIL)
    _ardour_cfg_defined("LV2 support" LV2_SUPPORT)
    _ardour_cfg_defined("LV2 extensions" LV2_EXTENDED)
    _ardour_cfg_defined("LXVST support" LXVST_SUPPORT)
    _ardour_cfg_defined("Mac VST support" MACVST_SUPPORT)
    _ardour_cfg_bool("NI-Maschine" ARDOUR_MASCHINE)
    _ardour_cfg_defined("OGG" HAVE_OGG)
    _ardour_cfg_defined("Phone home" PHONE_HOME)
    _ardour_cfg("Program name" "${ARDOUR_PROGRAM_NAME}")
    _ardour_cfg_defined("Samplerate" HAVE_SAMPLERATE)
    _ardour_cfg_defined("PT format" PTFORMAT)
    _ardour_cfg_defined("PTW32 Semaphore" USE_PTW32_SEMAPHORE)
    _ardour_cfg_bool("Threaded WaveViews" ARDOUR_THREADED_WAVEVIEWS)
    _ardour_cfg_bool("Translation" ARDOUR_NLS)
    _ardour_cfg_bool("Unit tests" ARDOUR_BUILD_TESTS)
    _ardour_cfg("Use LLD linker" "False")
    _ardour_cfg_defined("VST3 support" VST3_SUPPORT)
    _ardour_cfg_defined("Windows VST support" WINDOWS_VST_SUPPORT)
    _ardour_cfg_defined("Wiimote support" BUILD_WIIMOTE)
    _ardour_cfg("Windows key" "Mod4><Super")
    _ardour_cfg_gap()
    foreach (pair "PortAudio Backend|portaudio" "CoreAudio/Midi Backend|coreaudio"
            "ALSA Backend|alsa" "Dummy backend|dummy" "JACK Backend|jack"
            "PulseAudio Backend|pulseaudio")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 title)
        list(GET pair 1 backend)
        set(_has OFF)
        if (backend IN_LIST _backends)
            set(_has ON)
        endif ()
        _ardour_cfg_bool("${title}" _has)
    endforeach ()
    _ardour_cfg_gap()
    if (ARDOUR_DEPSTACK_ROOT)
        _ardour_cfg("Buildstack" "${ARDOUR_DEPSTACK_ROOT}")
    else ()
        _ardour_cfg("Buildstack" "-system-")
    endif ()
    _ardour_cfg("Mac i386 Architecture" "False")
    _ardour_cfg("Mac ppc Architecture" "False")
    _ardour_cfg("Mac arm64 Architecture" "False")
    _ardour_cfg_gap()
    # waf prints its CFLAGS/CXXFLAGS/LINKFLAGS lists here. The CMake flags are
    # spread over targets and generator expressions, so this names the build
    # system and type instead.
    _ardour_cfg("Build system" "CMake ${CMAKE_VERSION} (${CMAKE_GENERATOR})")
    _ardour_cfg("Build type" "${CMAKE_BUILD_TYPE}")
    _ardour_cfg("C compiler" "${CMAKE_C_COMPILER_ID} ${CMAKE_C_COMPILER_VERSION}")
    _ardour_cfg("C++ compiler" "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")

    file(CONFIGURE OUTPUT "${out}" CONTENT [==[#include "ardour/ardour.h"
namespace ARDOUR {
const char* const ardour_config_info = "\n\
@_text@";
}
]==] @ONLY)
endfunction()
